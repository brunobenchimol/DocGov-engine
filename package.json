{
  "name": "docgov-docx-engine",
  "version": "0.2.1",
  "description": "Motor standalone de inspeção, construção de templates e injeção em modelos Word (.docx) e servidor MCP via stdio para o ecossistema DocGov",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "build:linux": "bun build ./src/index.ts --compile --minify --outfile ./bin/docgov-docx",
    "build:windows": "bun build ./src/index.ts --compile --minify --outfile ./bin/docgov-docx.exe"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@xmldom/xmldom": "^0.8.10",
    "docx-templates": "^4.13.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun-types": "latest"
  }
}

